{
  "name": "@fourlyn/apple-foundation-models",
  "version": "0.1.1",
  "description": "The complete TypeScript/Expo SDK for Apple Foundation Models: on-device and Private Cloud Compute LLMs, streaming, structured output, tools, images, dynamic profiles and transcripts.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./react": {
      "types": "./build/react/index.d.ts",
      "react-native": "./src/react/index.ts",
      "default": "./build/react/index.js"
    },
    "./ai": {
      "types": "./build/ai/index.d.ts",
      "react-native": "./src/ai/index.ts",
      "default": "./build/ai/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "ios",
    "plugin/build",
    "app.plugin.js",
    "expo-module.config.json",
    "AGENTS.md",
    "llms.txt",
    "docs",
    "!ios/Tests",
    "!**/__tests__",
    "!**/*.test.ts",
    "!test-stubs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "clean": "rm -rf build plugin/build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run clean && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "apple-intelligence",
    "foundation-models",
    "llm",
    "on-device-ai",
    "private-cloud-compute",
    "ios",
    "ai-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fourlyn/apple-foundation-models.git"
  },
  "bugs": {
    "url": "https://github.com/fourlyn/apple-foundation-models/issues"
  },
  "homepage": "https://fourlyn.github.io/apple-foundation-models/",
  "author": "Fourlyn",
  "license": "MIT",
  "peerDependencies": {
    "@ai-sdk/provider": ">=4.0.0",
    "expo": ">=55.0.0",
    "react": "*",
    "react-native": "*",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.21",
    "@expo/config-plugins": "~57.0.9",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "ai": "^7.0.127",
    "expo": "~57.0.25",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3",
    "zod": "^4.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          },
          "diagnostics": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(ai|@ai-sdk|@workflow|@vercel|eventsource-parser)/)"
    ],
    "moduleNameMapper": {
      "^expo$": "<rootDir>/test-stubs/expo.ts",
      "^react-native$": "<rootDir>/test-stubs/react-native.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
